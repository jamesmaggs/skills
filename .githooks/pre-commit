#!/usr/bin/env bash
# Pre-commit checks — deterministic and offline; if it can't run, stop and
# investigate, don't bypass. Lint every SKILL.md against the Agent Skills spec.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
linter="$repo_root/scripts/lint_skill.py"
status=0

echo "pre-commit: linting skills…"
for skill_md in "$repo_root"/skills/*/SKILL.md; do
  [ -e "$skill_md" ] || continue
  python3 "$linter" "$skill_md" || status=1
done

exit "$status"
